datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  avatarUrl      String?
  college        String
  course         String
  department     String?
  year           Int
  headline       String?
  bio            String?
  interests      String?        // Comma separated domains: AI, Web, Systems, UI/UX
  availability   String?        // e.g., "15 hrs/week (Evenings & Weekends)"
  githubUrl      String?
  portfolioUrl   String?
  linkedinUrl    String?
  createdAt      DateTime       @default(now())

  skills         UserSkill[]
  projectMembers ProjectMember[]
  ownedProjects  Project[]      @relation("OwnedProjects")
  posts          Post[]
  comments       Comment[]
  postLikes      PostLike[]
  sentCollab     CollaborationRequest[] @relation("SentCollab")
  receivedCollab CollaborationRequest[] @relation("ReceivedCollab")
  notifications  Notification[]
}

model Skill {
  id            String         @id @default(cuid())
  name          String         @unique
  category      String         // "Frontend", "Backend", "AI / ML", "Database", "Design", "DevOps"
  userSkills    UserSkill[]
  projectSkills ProjectSkill[]
}

model UserSkill {
  id          String   @id @default(cuid())
  userId      String
  skillId     String
  status      String   @default("Comfortable") // "Learning", "Practicing", "Project Experience", "Comfortable"
  proficiency Int      @default(3)             // 1 to 5
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model Project {
  id          String         @id @default(cuid())
  ownerId     String
  title       String
  tagline     String?
  description String
  domain      String         // "AI & Machine Learning", "Web Development", "FinTech", "Mobile Apps"
  imageUrl    String?
  demoUrl     String?
  deadline    String?
  status      String         @default("recruiting") // "recruiting", "in_progress", "completed"
  repoUrl     String?
  createdAt   DateTime       @default(now())

  owner       User           @relation("OwnedProjects", fields: [ownerId], references: [id], onDelete: Cascade)
  skills      ProjectSkill[]
  members     ProjectMember[]
  tasks       Task[]
  collabReqs  CollaborationRequest[]
}

model ProjectSkill {
  id        String   @id @default(cuid())
  projectId String
  skillId   String
  role      String?  // e.g. "Frontend Engineer", "AI/ML Lead"
  priority  String   @default("required") // "required", "preferred"
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   // "Owner", "Fullstack Dev", "Designer", etc.
  joinedAt  DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Task {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      String   @default("todo") // "todo", "in_progress", "done"
  priority    String   @default("medium") // "low", "medium", "high"
  assigneeName String?
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Post {
  id        String     @id @default(cuid())
  userId    String
  content   String
  tag       String?    // "Project Milestone", "Hackathon Update", "Teammate Search", "Tech Resource"
  mediaUrl  String?
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments  Comment[]
  likes     PostLike[]
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model CollaborationRequest {
  id         String   @id @default(cuid())
  projectId  String
  senderId   String
  receiverId String
  role       String
  message    String?
  status     String   @default("pending") // "pending", "accepted", "rejected"
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender     User     @relation("SentCollab", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedCollab", fields: [receiverId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  link      String?
  type      String   @default("info") // "collab_request", "invitation", "like", "task"
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
